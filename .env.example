# Copy to .env for your own notes, or just export these in your shell.
# (The app reads real environment variables; it does not auto-load .env.)

# Use live CDC data instead of bundled SAMPLE data. Default: 0 (sample).
ILLNESS_LIVE=0

# Optional free Socrata app token to raise rate limits. NOT required.
# Get one at https://data.cdc.gov  ->  profile  ->  developer settings.
SOCRATA_APP_TOKEN=

# How long (seconds) to reuse a cached live response. Default 43200 = 12 hours.
ILLNESS_CACHE_TTL=43200
